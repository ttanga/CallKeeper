[Unit]
Description=CallKeeper Telegram control
After=network-online.target asterisk.service
Wants=network-online.target

[Service]
Type=simple
User=asterisk
Group=asterisk
WorkingDirectory=/apps/callkeeper
ExecStart=/apps/callkeeper/callkeeper-bin
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/apps/callkeeper/state

[Install]
WantedBy=multi-user.target
