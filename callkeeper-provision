#!/usr/bin/python3
"""Root helper: only allocate a new TLS SIP client in a preconfigured include."""
import fcntl
import json
import os
import re
import subprocess
import sys
from pathlib import Path

FILE=Path("/etc/asterisk/pjsip_callkeeper.conf")
MAIN=Path("/etc/asterisk/pjsip.conf")

def cli(cmd):
    p=subprocess.run(["/usr/sbin/asterisk","-rx",cmd],capture_output=True,text=True,timeout=20)
    if p.returncode or "Unable to connect" in p.stdout+p.stderr:
        raise RuntimeError("CLI failed")
    return p.stdout

def write(data):
    tmp=FILE.with_suffix(".tmp")
    fd=os.open(tmp,os.O_WRONLY|os.O_CREAT|os.O_EXCL,0o640)
    with os.fdopen(fd,"w") as f:
        f.write(data)
        os.fchown(f.fileno(),0,FILE.stat().st_gid)
        f.flush()
        os.fsync(f.fileno())
    os.replace(tmp,FILE)

def main():
    if len(sys.argv)!=1 or os.geteuid()!=0:
        raise RuntimeError("Invalid invocation")
    password=json.loads(sys.stdin.read(1024))["password"]
    if not re.fullmatch(r"[a-f0-9]{64}",password):
        raise ValueError("Invalid password")
    with open("/run/lock/callkeeper-provision.lock","w") as lock:
        fcntl.flock(lock,fcntl.LOCK_EX)
        if not re.search(r'^\s*#include\s+"?pjsip_callkeeper\.conf"?\s*$',MAIN.read_text(),re.M):
            raise RuntimeError("Missing include")
        if "transport-tls" not in cli("pjsip show transports"):
            raise RuntimeError("TLS unavailable")
        # Require operator-approved dynamic route before provisioning.
        if not Path("/etc/asterisk/callkeeper-provision.enabled").is_file():
            raise RuntimeError("Provisioning not approved")
        old=FILE.read_text()
        endpoints=cli("pjsip show endpoints")
        aors=cli("pjsip show aors")
        auths=cli("pjsip show auths")
        if not all("Objects found:" in x for x in (endpoints,aors,auths)):
            raise RuntimeError("Unexpected CLI output")
        used=old+endpoints+aors+auths+MAIN.read_text()
        key=next(str(i) for i in range(1004,2000) if not re.search(r"(?<!\d)"+str(i)+r"(?!\d)",used))
        block=f"""
[{key}]
type=endpoint
transport=transport-tls
context=from-client
disallow=all
allow=alaw,ulaw
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
rtp_keepalive=15
rtp_timeout=60
allow_transfer=no
allow_subscribe=no
media_encryption=sdes
media_encryption_optimistic=no
auth=ckauth{key}
aors={key}
[{key}]
type=aor
max_contacts=1
remove_existing=yes
qualify_frequency=25
qualify_timeout=20
default_expiration=120
[ckauth{key}]
type=auth
auth_type=userpass
username={key}
password={password}
"""
        write(old+"\n"+block)
        try:
            cli("pjsip reload")
            out=cli("pjsip show endpoint "+key)
            if not re.search(r"Endpoint:\s+"+key+r"(?:\s|/)",out) or "transport-tls" not in out:
                raise RuntimeError("Endpoint verification failed")
            cli("database put gateway_allowed "+key+" 1")
            if not re.search(r"Value:\s*1\s*$",cli("database get gateway_allowed "+key),re.M):
                raise RuntimeError("Route authorization failed")
        except Exception:
            cli("database del gateway_allowed "+key)
            write(old)
            cli("pjsip reload")
            raise
        print(key)

if __name__=="__main__":
    try:
        main()
    except Exception:
        print("Provisioning failed; inspect PBX locally",file=sys.stderr)
        sys.exit(1)
